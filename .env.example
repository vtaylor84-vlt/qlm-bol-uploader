# Local `npm run dev` login (copy to .env.local — never commit secrets)
#
# Without UPLOAD_TOKEN, Vite uses local fixture emails only:
#   driver@local.dev  (GLX driver)
#   bst@local.dev     (BST driver)
#   admin@local.dev   (admin + local Showcase grant)
#
# For live roster login against Apps Script, set:

UPLOAD_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOGIN_APPS_SCRIPT_WEB_APP_URL=
# SHOWCASE_GRANT_SECRET=
